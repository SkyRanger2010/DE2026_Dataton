<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>s3a://warehouse/</value>
  </property>
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://0.0.0.0:9083</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:mysql://mariadb:3306/metastore_db?createDatabaseIfNotExist=true</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>com.mysql.cj.jdbc.Driver</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionUserName</name>
    <value>hive</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionPassword</name>
    <value>metastore</value>
  </property>
  <!-- Standalone metastore: класс из hive-ql отсутствует; используем заглушку из metastore-server -->
  <property>
    <name>metastore.expression.proxy</name>
    <value>org.apache.hadoop.hive.metastore.DefaultPartitionExpressionProxy</value>
    <description>PartitionExpressionProxy для standalone HMS (без hive-ql). Иначе: PartitionExpressionForMetastore class not found.</description>
  </property>
  <!-- Пустой список «always»-задач (DumpDirCleanerTask и др. отсутствуют в образе). Дублируется в HADOOP_OPTS в docker-compose. -->
  <property>
    <name>hive.metastore.task.threads.always</name>
    <value></value>
    <description>Пусто = не запускать задачи репликации. Иначе ClassNotFoundException при старте.</description>
  </property>
  <property>
    <name>metastore.task.threads.always</name>
    <value></value>
    <description>Альтернативное имя ключа (MetastoreConf).</description>
  </property>
</configuration>
