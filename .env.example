# Копируйте в .env и при необходимости измените значения.
# Структура как в telecom-mart: два Postgres (airflow + meta), порты через переменные.

# --- Postgres Airflow (Airflow + Superset) ---
PG_AIRFLOW_USER=airflow
PG_AIRFLOW_PASSWORD=airflow
PG_AIRFLOW_DB=airflow
PG_AIRFLOW_PORT=5432

# --- Postgres Meta (Hive Metastore, БД hivemeta) ---
PG_META_USER=postgres
PG_META_PASSWORD=postgres
PG_META_PORT=5433

# --- MinIO (S3 для Iceberg) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Порты сервисов ---
TRINO_PORT=8082
SPARK_UI_PORT=8081
AIRFLOW_PORT=8080
SUPERSET_PORT=8088
KAFKA_PORT=9092
KAFKA_CONNECT_PORT=8083
KAFKA_UI_PORT=8090

# --- Airflow ---
AIRFLOW_UID=50000
# Ключ шифрования (не менять после первого запуска):
# AIRFLOW__CORE__FERNET_KEY=...

# --- Superset (обязательно в production) ---
SUPERSET_SECRET_KEY=change-me-in-production
